<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Targeting a Windows 10 SDK version gives this tray app access to
         WinRT / Windows.Devices.Bluetooth APIs without needing a full
         UWP/MSIX package. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BlePeripheralEmu</RootNamespace>
    <!-- Set explicitly rather than inherited from the project filename:
         installer.iss hard-references the produced .exe by name. -->
    <AssemblyName>BlePeripheralEmu</AssemblyName>
    <Product>BlePeripheralEmu</Product>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
